# Yuva runs with none of these set: it then keeps accounts and notices in the
# visitor's browser, which is how the public demonstration runs.

# The address the site is served from. It is printed on posters as the code
# to scan. On Vercel it is worked out without this; set it for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# To keep accounts and notices in MongoDB, set both of these.
# MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
# A long random string, at least 32 characters, used to sign sessions.
# YUVA_SECRET=
# The database name. "yuva" if left out.
# MONGODB_DB=yuva

# To try the server side with no database installed: accounts and notices are
# kept in the server's memory and are gone when it stops.
# YUVA_DB=memory
